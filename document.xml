<tryton>
    <data>
        <!-- papyrus.queue -->
        <record model="ir.ui.view" id="queue_view_form">
            <field name="model">papyrus.queue</field>
            <field name="inherit" ref="papyrus.papyrus_queue_view_form"/>
            <field name="name">queue_form</field>
        </record>

        <!-- papyrus.document -->
        <record model="ir.ui.view" id="document_view_form">
            <field name="model">papyrus.document</field>
            <field name="inherit" ref="papyrus.papyrus_document_view_form"/>
            <field name="name">document_form</field>
        </record>
        <record model="ir.ui.view" id="document_view_list">
            <field name="model">papyrus.document</field>
            <field name="inherit" ref="papyrus.papyrus_document_view_list"/>
            <field name="name">document_list</field>
        </record>

        <!-- papyrus.document.box -->
        <record model="ir.ui.view" id="papyrus_document_box_view_form">
            <field name="model">papyrus.document.box</field>
            <field name="inherit" ref="papyrus.papyrus_document_box_view_form"/>
            <field name="name">document_box_form</field>
        </record>
        <record model="ir.ui.view" id="papyrus_document_box_view_list">
            <field name="model">papyrus.document.box</field>
            <field name="inherit" ref="papyrus.papyrus_document_box_view_list"/>
            <field name="name">document_box_list</field>
        </record>

        <!-- papyrus.document.value -->
        <record model="ir.ui.view" id="papyrus_document_value_view_form">
            <field name="model">papyrus.document.value</field>
            <field name="type">form</field>
            <field name="name">document_value_form</field>
        </record>
        <record model="ir.ui.view" id="papyrus_document_value_view_list">
            <field name="model">papyrus.document.value</field>
            <field name="type">tree</field>
            <field name="name">document_value_list</field>
        </record>
    </data>
</tryton>
