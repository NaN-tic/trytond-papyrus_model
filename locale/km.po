#, python-format
msgctxt "model:ir.message,text:msg_cannot_change_company_invoice"
msgid ""
"The company of the document \"%(document)s\" and invoice \"%(model)s\" do not"
" match"
msgstr ""
"ក្រុមហ៊ុនរបស់ឯកសារ «%(document)s» និងរបស់វិក្កយបត្រ «%(model)s» មិនត្រូវគ្នា។"

#, python-format
msgctxt "model:ir.message,text:msg_cannot_change_company_sale"
msgid ""
"The company of the document \"%(document)s\" and sale \"%(model)s\" do not "
"match"
msgstr ""
"ក្រុមហ៊ុនរបស់ឯកសារ «%(document)s» និងរបស់ការលក់ «%(model)s» មិនត្រូវគ្នា។"

#, python-format
msgctxt "model:ir.message,text:msg_cannot_change_company_shipment_in"
msgid ""
"The company of the document \"%(document)s\" and shipment \"%(model)s\" do "
"not match"
msgstr ""
"ក្រុមហ៊ុនរបស់ឯកសារ «%(document)s» និងរបស់ការដឹកជញ្ជូន «%(model)s» "
"មិនត្រូវគ្នា។"

#, python-format
msgctxt "model:ir.message,text:msg_cannot_create_lines_with_unmatched_products"
msgid ""
"Document \"%(document)s\" still has %(total)s lines without product. Match or"
" fill products in the related record (Invoice/Sale/Shipment, Papyrus Lines "
"tab) before creating final lines."
msgstr ""
"ឯកសារ «%(document)s» នៅមានបន្ទាត់គ្មានផលិតផលចំនួន %(total)s។ ផ្គូផ្គង "
"ឬបញ្ចូលផលិតផលក្នុងកំណត់ត្រាពាក់ព័ន្ធ (វិក្កយបត្រ/ការលក់/ការដឹកជញ្ជូន "
"ក្នុងផ្ទាំង «បន្ទាត់ Papyrus») មុននឹងបង្កើតបន្ទាត់ចុងក្រោយ។"

#, python-format
msgctxt "model:ir.message,text:msg_cannot_delete_with_related_record"
msgid ""
"Document \"%(document)s\" cannot be removed because \"%(record)s\" "
"(%(model_type)s) is linked to it. You must remove or unlink the related "
"record first."
msgstr ""
"មិនអាចលុបឯកសារ «%(document)s» បានទេ ព្រោះ «%(record)s» (%(model_type)s) "
"ភ្ជាប់ជាមួយវា។ សូមលុបកំណត់ត្រាពាក់ព័ន្ធ ឬផ្ដាច់តំណរបស់វាជាមុន។"

#, python-format
msgctxt "model:ir.message,text:msg_cannot_pending_with_related_record"
msgid ""
"Document \"%(document)s\" cannot move to \"Pending\" because \"%(record)s\" "
"(%(model_type)s) is linked to it. You must remove or unlink the related "
"record first."
msgstr ""
"មិនអាចកំណត់ឯកសារ «%(document)s» ទៅស្ថានភាព «កំពុងរង់ចាំ» បានទេ ព្រោះ "
"«%(record)s» (%(model_type)s) ភ្ជាប់ជាមួយវា។ សូមលុបកំណត់ត្រាពាក់ព័ន្ធ "
"ឬផ្ដាច់តំណរបស់វាជាមុន។"

#, python-format
msgctxt "model:ir.message,text:msg_cannot_process_without_related_record"
msgid ""
"Document \"%(document)s\" has model type \"%(model_type)s\" but no related "
"record has been created yet."
msgstr ""
"ឯកសារ «%(document)s» មានប្រភេទម៉ូដែល «%(model_type)s» "
"ប៉ុន្តែមិនទាន់បានបង្កើតកំណត់ត្រាពាក់ព័ន្ធ។"

#, python-format
msgctxt "model:ir.message,text:msg_invoice_line_missing_product"
msgid ""
"No product is assigned to \"%(line)s\" in invoice \"%(invoice)s\", so no "
"invoice line can be matched."
msgstr ""
"មិនបានកំណត់ផលិតផលសម្រាប់ «%(line)s» ក្នុងវិក្កយបត្រ «%(invoice)s» "
"ដូច្នេះមិនអាចផ្គូផ្គងបន្ទាត់វិក្កយបត្របានទេ។"

#, python-format
msgctxt "model:ir.message,text:msg_invoice_line_not_found"
msgid ""
"No invoice line candidate was found for \"%(line)s\" in invoice "
"\"%(invoice)s\"."
msgstr ""
"រកមិនឃើញបន្ទាត់វិក្កយបត្រសម្រាប់ផ្គូផ្គង «%(line)s» ក្នុងវិក្កយបត្រ "
"«%(invoice)s» ទេ។"

#, python-format
msgctxt "model:ir.message,text:msg_mismatch_product"
