msgctxt "model:ir.message,text:msg_cannot_change_company"
msgid ""
"The company of the document \"%(document)s\" and invoice \"%(invoice)s\" do "
"not match"
msgstr ""
"La empresa del document \"%(document)s\" i de la factura \"%(invoice)s\" no "
"coincideixen"

msgctxt "model:ir.message,text:msg_cannot_delete_with_related_record"
msgid ""
"Document \"%(document)s\" cannot be removed because \"%(record)s\" "
"(%(model_type)s) is linked to it. You must remove or unlink the related "
"record first."
msgstr ""
"El document \"%(document)s\" no es pot eliminar perquè \"%(record)s\" "
"(%(model_type)s) hi està vinculat. Cal que primer eliminis o desvinculis el "
"registre relacionat."

msgctxt "model:ir.message,text:msg_cannot_pending_with_related_record"
msgid ""
"Document \"%(document)s\" cannot move to \"Pending\" because \"%(record)s\" "
"(%(model_type)s) is linked to it. You must remove or unlink the related "
"record first."
msgstr ""
"El document \"%(document)s\" no es pot passar a estat pendent perquè "
"\"%(record)s\" (%(model_type)s) hi està vinculat. Cal que primer eliminis o "
"desvinculis el registre relacionat."

msgctxt "model:ir.message,text:msg_cannot_process_without_related_record"
msgid ""
"If you have a model type selected, you cannot process the document without "
"creating the related model."
msgstr ""
"Si té seleccionat un tipus de model, no pot processar el document sense "
"crear el model relacionat."

