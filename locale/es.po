msgctxt "model:ir.message,text:msg_cannot_change_company_invoice"
msgid ""
"The company of the document \"%(document)s\" and invoice \"%(model)s\" do "
"not match"
msgstr ""
"La empresa del documento \"%(document)s\" y de la factura \"%(model)s\" no"
" coinciden"

msgctxt "model:ir.message,text:msg_cannot_change_company_sale"
msgid ""
"The company of the document \"%(document)s\" and sale \"%(model)s\" do "
"not match"
msgstr ""
"La empresa del documento \"%(document)s\" y de la venta \"%(model)s\" no "
"coinciden"

msgctxt "model:ir.message,text:msg_cannot_change_company_shipment_in"
msgid ""
"The company of the document \"%(document)s\" and shipment \"%(model)s\" do "
"not match"
msgstr ""
"La empresa del documento \"%(document)s\" y del albarán \"%(model)s\" no "
"coinciden"

msgctxt "model:ir.message,text:msg_cannot_create_lines_with_unmatched_products"
msgid ""
"Document \"%(document)s\" still has %(total)s lines without product. Match "
"or fill products in the related record (Invoice/Sale/Shipment, Papyrus "
"Lines tab) before creating final lines."
msgstr ""
"El documento \"%(document)s\" todavía tiene %(total)s líneas sin producto. "
"Relacione o complete los productos en el registro relacionado "
"(factura/venta/albarán, pestaña Líneas Papyrus) antes de crear las líneas "
"finales."

msgctxt "model:ir.message,text:msg_invoice_line_not_found"
msgid "No invoice line candidate was found."
msgstr "No se ha encontrado ninguna línea de factura candidata."

msgctxt "model:ir.message,text:msg_invoice_line_missing_product"
msgid "No product is assigned, so no invoice line can be matched."
msgstr "No hay ningún producto asignado, por lo que no se puede relacionar ninguna línea de factura."

msgctxt "model:ir.message,text:msg_purchase_line_not_found"
msgid "No purchase line candidate was found."
msgstr "No se ha encontrado ninguna línea de compra candidata."

msgctxt "model:ir.message,text:msg_purchase_line_missing_product"
msgid "No product is assigned, so no purchase line can be matched."
msgstr "No hay ningún producto asignado, por lo que no se puede relacionar ninguna línea de compra."

msgctxt "model:ir.message,text:msg_sale_line_not_found"
msgid "No sale line candidate was found."
msgstr "No se ha encontrado ninguna línea de venta candidata."

msgctxt "model:ir.message,text:msg_sale_line_missing_product"
msgid "No product is assigned, so no sale line can be matched."
msgstr "No hay ningún producto asignado, por lo que no se puede relacionar ninguna línea de venta."

msgctxt "model:ir.message,text:msg_move_not_found"
msgid "No stock move candidate was found."
msgstr "No se ha encontrado ningún movimiento de stock candidato."

msgctxt "model:ir.message,text:msg_move_missing_product"
msgid "No product is assigned, so no move can be matched."
msgstr "No hay ningún producto asignado, por lo que no se puede relacionar ningún movimiento."

msgctxt "model:ir.message,text:msg_mismatch_product"
msgid "Product mismatch"
msgstr "El producto no coincide"

msgctxt "model:ir.message,text:msg_mismatch_quantity"
msgid "Quantity mismatch"
msgstr "La cantidad no coincide"

msgctxt "model:ir.message,text:msg_mismatch_unit_price"
msgid "Unit price mismatch"
msgstr "El precio unitario no coincide"

msgctxt "model:ir.message,text:msg_cannot_delete_with_related_record"
msgid ""
"Document \"%(document)s\" cannot be removed because \"%(record)s\" "
"(%(model_type)s) is linked to it. You must remove or unlink the related "
"record first."
msgstr ""
"El documento \"%(document)s\" no se puede eliminar porqué \"%(record)s\" "
"(%(model_type)s) está vinculado a él. Primero debe eliminar o desvinular el "
"registro relacionado."

msgctxt "model:ir.message,text:msg_cannot_pending_with_related_record"
msgid ""
"Document \"%(document)s\" cannot move to \"Pending\" because \"%(record)s\" "
"(%(model_type)s) is linked to it. You must remove or unlink the related "
"record first."
msgstr ""
"El documento \"%(document)s\" no se puede pasar a estado pendiente porqué "
"\"%(record)s\" (%(model_type)s) está vinculado a él. Primero debe eliminar o"
" desvinular el registro relacionado."

msgctxt "model:ir.message,text:msg_cannot_process_without_related_record"
msgid ""
"If you have a model type selected, you cannot process the document without "
"creating the related model."
msgstr ""
"Si tiene seleccionado un tipo de modelo, no puede procesar el documento sin "
"crear el modelo relacionado."

