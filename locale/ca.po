msgctxt "model:ir.message,text:msg_cannot_change_company_invoice"
msgid ""
"The company of the document \"%(document)s\" and invoice \"%(model)s\" do "
"not match"
msgstr ""
"La empresa del document \"%(document)s\" i de la factura \"%(model)s\" no "
"coincideixen"

msgctxt "model:ir.message,text:msg_cannot_change_company_sale"
msgid ""
"The company of the document \"%(document)s\" and sale \"%(model)s\" do not "
"match"
msgstr ""
"La empresa del document \"%(document)s\" i de la venda \"%(model)s\" no "
"coincideixen"

msgctxt "model:ir.message,text:msg_cannot_change_company_shipment_in"
msgid ""
"The company of the document \"%(document)s\" and shipment \"%(model)s\" do "
"not match"
msgstr ""
"La empresa del document \"%(document)s\" i del albarà \"%(model)s\" no "
"coincideixen"

msgctxt "model:ir.message,text:msg_cannot_create_lines_with_unmatched_products"
msgid ""
"Document \"%(document)s\" still has %(total)s lines without product. Match "
"or fill products in the related record (Invoice/Sale/Shipment, Papyrus Lines"
" tab) before creating final lines."
msgstr ""
"El document \"%(document)s\" encara té %(total)s línies sense producte. "
"Relaciona o completa els productes al registre relacionat "
"(factura/venda/albarà, pestanya Línies Papyrus) abans de crear les línies "
"finals."

msgctxt "model:ir.message,text:msg_cannot_delete_with_related_record"
msgid ""
"Document \"%(document)s\" cannot be removed because \"%(record)s\" "
"(%(model_type)s) is linked to it. You must remove or unlink the related "
"record first."
msgstr ""
"El document \"%(document)s\" no es pot eliminar perquè \"%(record)s\" "
"(%(model_type)s) hi està vinculat. Cal que primer eliminis o desvinculis el "
"registre relacionat."

msgctxt "model:ir.message,text:msg_cannot_pending_with_related_record"
msgid ""
"Document \"%(document)s\" cannot move to \"Pending\" because \"%(record)s\" "
"(%(model_type)s) is linked to it. You must remove or unlink the related "
"record first."
msgstr ""
"El document \"%(document)s\" no es pot passar a estat pendent perquè "
"\"%(record)s\" (%(model_type)s) hi està vinculat. Cal que primer eliminis o "
"desvinculis el registre relacionat."

msgctxt "model:ir.message,text:msg_cannot_process_without_related_record"
msgid ""
"Document \"%(document)s\" has model type \"%(model_type)s\" but no related "
"record has been created yet."
msgstr ""
"El document \"%(document)s\" té el tipus de model \"%(model_type)s\" però "
"encara no s'ha creat cap registre relacionat."

msgctxt "model:ir.message,text:msg_invoice_line_missing_product"
msgid ""
"No product is assigned to \"%(line)s\" in invoice \"%(invoice)s\", so no "
"invoice line can be matched."
msgstr ""
"No hi ha cap producte assignat a \"%(line)s\" a la factura \"%(invoice)s\", "
"per tant, no es pot trobar cap línia de factura coincident."

msgctxt "model:ir.message,text:msg_invoice_line_not_found"
msgid ""
"No invoice line candidate was found for \"%(line)s\" in invoice "
"\"%(invoice)s\"."
msgstr ""
"No s'ha trobat cap candidata a línia de factura per a \"%(line)s\" a la "
"factura \"%(invoice)s\"."

msgctxt "model:ir.message,text:msg_mismatch_product"
msgid ""
"Product mismatch: Papyrus \"%(papyrus)s\" vs Invoice Line \"%(invoice)s\""
msgstr ""
"Discrepància de productes: Papyrus \"%(papyrus)s\" vs. línia de factura "
"\"%(invoice)s\""

msgctxt "model:ir.message,text:msg_mismatch_quantity"
msgid "Quantity mismatch: Papyrus %(papyrus)s vs Invoice Line %(invoice)s"
msgstr ""
"Discrepància de quantitat: Papyrus %(papyrus)s vs. línia de factura "
"%(invoice)s"

msgctxt "model:ir.message,text:msg_mismatch_unit_price"
msgid "Unit price mismatch: Papyrus %(papyrus)s vs Invoice Line %(invoice)s"
msgstr ""
"Discrepància del preu unitari: Papyrus %(papyrus)s vs. línia de factura "
"%(invoice)s"

