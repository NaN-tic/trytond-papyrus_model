#, python-format
msgctxt "model:ir.message,text:msg_papyrus_pending_lines"
msgid ""
"Document \"%(document)s\" still has %(total)s pending Papyrus lines. Review "
"them before continuing, or confirm this warning to continue with the lines "
"already created."
msgstr ""
"A(z) „%(document)s” dokumentumban még %(total)s függőben lévő Papyrus-tétel "
"van. Ellenőrizze őket a folytatás előtt, vagy hagyja jóvá ezt a "
"figyelmeztetést a már létrehozott tételekkel való folytatáshoz."

#, python-format
msgctxt "model:ir.message,text:msg_previous_sale_not_quotation"
msgid ""
"Previous sale \"%(sale)s\" is not an active quotation and cannot be linked."
msgstr ""
"A korábbi „%(sale)s” értékesítés nem aktív ajánlat, ezért nem kapcsolható."

#, python-format
msgctxt "model:ir.message,text:msg_previous_sale_expired"
msgid ""
"Sale \"%(sale)s\" refers to expired quotation(s) %(quotations)s. Review the "
"prices before confirming."
msgstr ""
"A(z) „%(sale)s” értékesítés lejárt ajánlatokra hivatkozik: %(quotations)s. "
"Jóváhagyás előtt ellenőrizze az árakat."

msgctxt "model:ir.message,text:msg_sale_previous_sale_unique"
msgid "A previous sale can only be linked once to the same sale."
msgstr ""
"Egy korábbi értékesítés csak egyszer kapcsolható ugyanahhoz az "
"értékesítéshez."

