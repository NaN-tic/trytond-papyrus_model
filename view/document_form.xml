<data>
    <xpath expr="/form/notebook/page[@id='image']/group[@id='extra']" position="inside">
        <label name="model_type"/>
        <field name="model_type"/>
        <field name="invoice" mode="form,tree" colspan="4"/>
        <field name="sale" mode="form,tree" colspan="4"/>
        <field name="shipment_in" mode="form,tree" colspan="4"/>
    </xpath>
    <xpath expr="/form/notebook/page[@id='image']" position="after">
        <page name="extracted_data" string="Extracted Data">
            <group>
                <field name="extracted_data" nolabel="1" colspan="4" widget="text" options="{'no_buttons': True}" style="height: 300px;"/>
            </group>
        </page>
    </xpath>
</data>
