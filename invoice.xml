<tryton>
    <data depends="account_invoice">
        <record model="ir.ui.view" id="invoice_view_form">
            <field name="model">account.invoice</field>
            <field name="inherit" ref="account_invoice.invoice_view_form"/>
            <field name="name">invoice_form</field>
        </record>
        <record model="ir.ui.view" id="invoice_view_tree">
            <field name="model">account.invoice</field>
            <field name="inherit" ref="account_invoice.invoice_view_tree"/>
            <field name="name">invoice_tree</field>
        </record>

        <record model="ir.ui.view" id="invoice_document_view_form">
            <field name="model">papyrus.document</field>
            <field name="inherit" ref="papyrus.papyrus_document_view_form"/>
            <field name="name">invoice_document_form</field>
        </record>

        <record model="ir.action.wizard" id="act_open_dossier">
            <field name="name">Invoice Dossier</field>
            <field name="wiz_name">invoice.dossier</field>
        </record>
        <record model="ir.action.keyword" id="action_open_dossier">
            <field name="action" ref="act_open_dossier"/>
            <field name="keyword">form_relate</field>
            <field name="model">account.invoice,-1</field>
        </record>

        <record model="ir.ui.view" id="papyrus_invoice_line_form">
            <field name="model">papyrus.invoice.line</field>
            <field name="type">form</field>
            <field name="name">papyrus_invoice_line_form</field>
        </record>
        <record model="ir.ui.view" id="papyrus_invoice_line_tree">
            <field name="model">papyrus.invoice.line</field>
            <field name="type">tree</field>
            <field name="name">papyrus_invoice_line_tree</field>
        </record>
    </data>
</tryton>
